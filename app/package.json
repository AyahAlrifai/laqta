{
  "name": "@laqta/app",
  "productName": "Laqta",
  "version": "0.0.0",
  "private": true,
  "description": "Turn a screenshot and one sentence into a reviewed Jira bug.",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "mock-jira": "tsx test/run-mock-jira.ts",
    "build:release": "LAQTA_RELEASE=1 electron-vite build",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@laqta/gateway-contract": "workspace:*",
    "electron-updater": "6.8.11",
    "get-windows": "9.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
